# ==========================================================================
# Storify — Environment Variables
# --------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values for your environment.
#   cp .env.example .env
#
# NOTE ON EXTERNAL SERVICE COSTS: Several integrations below rely on
# third-party services that may charge usage fees or require a paid
# subscription. The AI-powered features require an OpenAI API key (billed
# per token by OpenAI), and the payment gateways (Stripe, PayPal, Paystack,
# Razorpay) charge transaction fees per their pricing. Configure only the
# providers you intend to use.
#
# TWO SOURCES OF CONFIG: Integration credentials (payments, OAuth/social login,
# SMTP, storage, analytics) can be set either here in `.env` OR in the Admin
# panel -> Settings. A value saved in Settings (database) always wins; the
# matching variable below is used as a per-field fallback. This lets you boot
# from `.env` and later override individual fields from the UI.
# ==========================================================================

# --------------------------------------------------------------------------
# Database (required)
# --------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/storify?authSource=admin&retryWrites=true&w=majority
MONGODB_DB_NAME=storify

# --------------------------------------------------------------------------
# Authentication — Better Auth (required)
# Generate a random 32+ character secret, e.g. `openssl rand -base64 32`
# --------------------------------------------------------------------------
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3000

# --------------------------------------------------------------------------
# OAuth / Social login (optional — also configurable in Settings -> OAuth)
# When credentials are supplied here, the provider is enabled automatically
# even without toggling it on in the Admin panel.
# --------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# --------------------------------------------------------------------------
# App configuration (required)
# Multi-vendor marketplace mode is toggled at runtime from
# Admin -> Settings -> Multi-vendor (stored in the database), not via .env.
# --------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Storify
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Set to "true" on public demos to block admin settings edits, uploads, deletes, and test actions
DEMO_MODE=false
# Set to "true" to enable the PWA / service worker during local development
NEXT_PUBLIC_ENABLE_PWA_IN_DEV=false

# --------------------------------------------------------------------------
# Initial admin account — fallbacks for `pnpm create-admin <email> [password] [name]`.
# The email is always passed on the command line; if the password/name
# arguments are omitted, these values are used instead.
# --------------------------------------------------------------------------
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# --------------------------------------------------------------------------
# OpenAI — powers the AI assistant / AI content tools (optional)
# WARNING: Usage is billed by OpenAI per their API pricing.
# https://openai.com/api/pricing/
# --------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here
# Enable the admin Home Page Hero banner generator. Defaults to disabled.
AI_HERO_BANNER_ENABLED=false

# --------------------------------------------------------------------------
# Web Push notifications (optional)
# Generate keys with: `pnpm push:keys`
# --------------------------------------------------------------------------
WEB_PUSH_PUBLIC_KEY=your-web-push-public-key-here
WEB_PUSH_PRIVATE_KEY=your-web-push-private-key-here
WEB_PUSH_SUBJECT=mailto:admin@example.com
# Public key also exposed to the browser
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your-web-push-public-key-here

# --------------------------------------------------------------------------
# Email / SMTP (required for transactional emails)
# --------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
CRON_SECRET=replace-with-a-long-random-secret
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Storify <no-reply@example.com>"

# --------------------------------------------------------------------------
# Payment gateways (optional — configure the providers you use)
# WARNING: Each provider charges transaction fees per their pricing.
# --------------------------------------------------------------------------

# Stripe — https://stripe.com/pricing
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal — https://www.paypal.com/us/webapps/mpp/merchant-fees
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Paystack — https://paystack.com/pricing
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx

# Razorpay — https://razorpay.com/pricing/
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --------------------------------------------------------------------------
# Object storage (optional — also configurable in Settings -> Storage)
# Works with AWS S3, Cloudflare R2, or any S3-compatible provider. Settings
# saved in the Admin panel override these per field.
#   - For Cloudflare R2, set STORAGE_ENDPOINT to the R2 S3 API endpoint
#     (https://<account-id>.r2.cloudflarestorage.com) and STORAGE_REGION=auto.
#   - For AWS S3, set STORAGE_REGION (e.g. us-east-1) and leave STORAGE_ENDPOINT
#     blank.
# --------------------------------------------------------------------------
STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key
STORAGE_ACCOUNT_ID=your-r2-account-id
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=your-bucket-name
# Public base URL / CDN for serving uploaded files
STORAGE_PUBLIC_URL=https://your-public-bucket-url.com
# Legacy fallback for the R2 public URL (still honoured if STORAGE_PUBLIC_URL is unset)
CLOUDFLARE_R2_PUBLIC_URL=https://your-r2-public-bucket-url.com

# --------------------------------------------------------------------------
# Analytics / tracking (optional — also configurable in Settings -> Analytics)
# These IDs are exposed to the browser for client-side tracking scripts.
# --------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your-tiktok-pixel-id
# Plausible API key (server-side; used for the admin analytics dashboard)
PLAUSIBLE_API_KEY=your-plausible-api-key
# Optional: signed QZ Tray direct/silent thermal printing. Keep the private
# key on the server only. Use literal newlines or escaped \\n sequences.
QZ_TRAY_CERTIFICATE=""
QZ_TRAY_PRIVATE_KEY=""
